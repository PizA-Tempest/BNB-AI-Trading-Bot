# --- Binance API (only needed for live trading; never commit real keys) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Trading mode: paper (default/safe) ---
TRADING_MODE=paper
LIVE_TRADING=false
BACKTEST=true
PAPER_TRADING=true

# --- Signal ---
CONFIDENCE_THRESHOLD=0.95

# --- Risk ---
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03

# --- Data ---
SYMBOL=BNBUSDT
INTERVAL=15m
DATA_DIR=data/raw
